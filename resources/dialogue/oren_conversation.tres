[gd_resource type="Resource" script_class="DialogueConversation" format=3 uid="uid://bg6uqh3h3lib6"]

[ext_resource type="Script" uid="uid://c72ou4xympa8k" path="res://scripts/data/dialogue/dialogue_conversation.gd" id="1_conversation"]
[ext_resource type="Script" uid="uid://bn5tdgpsujh6q" path="res://scripts/data/dialogue/dialogue_action.gd" id="2_c4o5p"]
[ext_resource type="Script" uid="uid://de2gtyvn62a4q" path="res://scripts/data/dialogue/dialogue_entry.gd" id="2_entry"]
[ext_resource type="Script" uid="uid://dpbifjko4digr" path="res://scripts/data/dialogue/dialogue_speaker.gd" id="3_speaker"]
[ext_resource type="Script" uid="uid://bw8gfgi66jkgt" path="res://scripts/data/dialogue/dialogue_response.gd" id="4_7vuwk"]
[ext_resource type="Script" uid="uid://chsetq55irrf0" path="res://scripts/data/dialogue/dialogue_condition.gd" id="4_condition"]

[sub_resource type="Resource" id="ConditionVictory"]
script = ExtResource("4_condition")
condition_id = &"context_equals"
parameters = Dictionary[StringName, Variant]({
&"key": &"main_progression",
&"value": &"victory"
})

[sub_resource type="Resource" id="Speaker"]
script = ExtResource("3_speaker")
speaker_id = &"oren"
display_name = "Oren"

[sub_resource type="Resource" id="EntryVictory"]
script = ExtResource("2_entry")
entry_id = &"victory"
speaker = SubResource("Speaker")
pages = Array[String](["I've watched this valley weather many hard years, but today feels like the beginning of a better one."])
skip_entry_id = &"ogre_threat"
conditions = Array[ExtResource("4_condition")]([SubResource("ConditionVictory")])

[sub_resource type="Resource" id="ConditionOgre"]
script = ExtResource("4_condition")
condition_id = &"context_equals"
parameters = Dictionary[StringName, Variant]({
&"key": &"main_progression",
&"value": &"ogre_threat"
})

[sub_resource type="Resource" id="EntryOgre"]
script = ExtResource("2_entry")
entry_id = &"ogre_threat"
speaker = SubResource("Speaker")
pages = Array[String](["Those broken trees are ogre work. I saw the same signs years ago, and I hoped never to see them again."])
skip_entry_id = &"orc_threat"
conditions = Array[ExtResource("4_condition")]([SubResource("ConditionOgre")])

[sub_resource type="Resource" id="ConditionOrc"]
script = ExtResource("4_condition")
condition_id = &"context_equals"
parameters = Dictionary[StringName, Variant]({
&"key": &"main_progression",
&"value": &"orc_threat"
})

[sub_resource type="Resource" id="EntryOrc"]
script = ExtResource("2_entry")
entry_id = &"orc_threat"
speaker = SubResource("Speaker")
pages = Array[String](["I scouted orc camps when I was younger. Break their command, and the rest usually lose their nerve."])
skip_entry_id = &"goblin_threat"
conditions = Array[ExtResource("4_condition")]([SubResource("ConditionOrc")])

[sub_resource type="Resource" id="EntryGoblin"]
script = ExtResource("2_entry")
entry_id = &"goblin_threat"
speaker = SubResource("Speaker")
pages = Array[String](["Name's Oren. I used to scout these woods. Goblins are bold in numbers, but they'll scatter when pressed."])

[resource]
script = ExtResource("1_conversation")
conversation_id = &"oren_ambient"
start_entry_id = &"victory"
entries = Array[ExtResource("2_entry")]([SubResource("EntryVictory"), SubResource("EntryOgre"), SubResource("EntryOrc"), SubResource("EntryGoblin")])
