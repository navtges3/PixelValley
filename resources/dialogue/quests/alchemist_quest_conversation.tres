[gd_resource type="Resource" script_class="DialogueConversation" format=3 uid="uid://bggdb2svwljrr"]

[ext_resource type="Script" uid="uid://c72ou4xympa8k" path="res://scripts/data/dialogue/dialogue_conversation.gd" id="1_conversation"]
[ext_resource type="Script" uid="uid://de2gtyvn62a4q" path="res://scripts/data/dialogue/dialogue_entry.gd" id="2_entry"]
[ext_resource type="Script" uid="uid://bw8gfgi66jkgt" path="res://scripts/data/dialogue/dialogue_response.gd" id="3_response"]
[ext_resource type="Script" uid="uid://dpbifjko4digr" path="res://scripts/data/dialogue/dialogue_speaker.gd" id="4_speaker"]
[ext_resource type="Script" uid="uid://chsetq55irrf0" path="res://scripts/data/dialogue/dialogue_condition.gd" id="5_condition"]
[ext_resource type="Script" uid="uid://bn5tdgpsujh6q" path="res://scripts/data/dialogue/dialogue_action.gd" id="6_action"]

[sub_resource type="Resource" id="ConditionQuest11"]
script = ExtResource("5_condition")
condition_id = &"context_equals"
parameters = Dictionary[StringName, Variant]({
&"key": &"quest_id",
&"value": 1010
})

[sub_resource type="Resource" id="ConditionReady"]
script = ExtResource("5_condition")
condition_id = &"context_equals"
parameters = Dictionary[StringName, Variant]({
&"key": &"quest_state",
&"value": &"ready"
})

[sub_resource type="Resource" id="ActionTurnIn"]
script = ExtResource("6_action")
action_id = &"turn_in_quest"

[sub_resource type="Resource" id="ResponseTurnIn"]
script = ExtResource("3_response")
text = "Thank you. I'll take the potion."
next_entry_id = &"quest_11_rewarded"
actions = Array[ExtResource("6_action")]([SubResource("ActionTurnIn")])

[sub_resource type="Resource" id="ActionService"]
script = ExtResource("6_action")
action_id = &"open_service"

[sub_resource type="Resource" id="ResponseShop"]
script = ExtResource("3_response")
text = "Show me your potions."
actions = Array[ExtResource("6_action")]([SubResource("ActionService")])

[sub_resource type="Resource" id="Speaker"]
script = ExtResource("4_speaker")
speaker_id = &"alchemist"
display_name = "Tamsin Reed"

[sub_resource type="Resource" id="EntryQuest11Ready"]
script = ExtResource("2_entry")
entry_id = &"quest_11_ready"
speaker = SubResource("Speaker")
pages = Array[String](["Mara sent you? Excellent timing. This restorative is ready for a field test.", "Take this lesser healing potion for your trouble."])
skip_entry_id = &"quest_11_active"
conditions = Array[ExtResource("5_condition")]([SubResource("ConditionQuest11"), SubResource("ConditionReady")])
responses = Array[ExtResource("3_response")]([SubResource("ResponseTurnIn"), SubResource("ResponseShop")])

[sub_resource type="Resource" id="ActionCompleteInteraction"]
script = ExtResource("6_action")
action_id = &"complete_npc_interaction"

[sub_resource type="Resource" id="ConditionActive"]
script = ExtResource("5_condition")
condition_id = &"context_equals"
parameters = Dictionary[StringName, Variant]({
&"key": &"quest_state",
&"value": &"active"
})

[sub_resource type="Resource" id="EntryQuest11Active"]
script = ExtResource("2_entry")
entry_id = &"quest_11_active"
speaker = SubResource("Speaker")
pages = Array[String](["Mara sent you to help with my restorative? Excellent. I have your sample ready now."])
next_entry_id = &"quest_11_ready"
skip_entry_id = &"quest_12_offered"
conditions = Array[ExtResource("5_condition")]([SubResource("ConditionQuest11"), SubResource("ConditionActive")])
actions = Array[ExtResource("6_action")]([SubResource("ActionCompleteInteraction")])

[sub_resource type="Resource" id="ConditionQuest12"]
script = ExtResource("5_condition")
condition_id = &"context_equals"
parameters = Dictionary[StringName, Variant]({
&"key": &"quest_id",
&"value": 1020
})

[sub_resource type="Resource" id="ConditionOffered"]
script = ExtResource("5_condition")
condition_id = &"context_equals"
parameters = Dictionary[StringName, Variant]({
&"key": &"quest_state",
&"value": &"offered"
})

[sub_resource type="Resource" id="ActionAccept"]
script = ExtResource("6_action")
action_id = &"accept_quest"

[sub_resource type="Resource" id="ResponseAccept"]
script = ExtResource("3_response")
text = "I'll speak with the blacksmith."
next_entry_id = &"quest_12_accepted"
actions = Array[ExtResource("6_action")]([SubResource("ActionAccept")])

[sub_resource type="Resource" id="ActionDecline"]
script = ExtResource("6_action")
action_id = &"decline_quest"

[sub_resource type="Resource" id="ResponseDecline"]
script = ExtResource("3_response")
text = "Not right now."
next_entry_id = &"quest_12_declined"
actions = Array[ExtResource("6_action")]([SubResource("ActionDecline")])

[sub_resource type="Resource" id="EntryQuest12Offered"]
script = ExtResource("2_entry")
entry_id = &"quest_12_offered"
speaker = SubResource("Speaker")
pages = Array[String](["Before you leave, the blacksmith asked me to send a capable traveler his way.", "Would you introduce yourself at the weapon shop?"])
skip_entry_id = &"quest_12_active"
conditions = Array[ExtResource("5_condition")]([SubResource("ConditionQuest12"), SubResource("ConditionOffered")])
responses = Array[ExtResource("3_response")]([SubResource("ResponseAccept"), SubResource("ResponseDecline"), SubResource("ResponseShop")])

[sub_resource type="Resource" id="EntryQuest12Active"]
script = ExtResource("2_entry")
entry_id = &"quest_12_active"
speaker = SubResource("Speaker")
pages = Array[String](["The blacksmith is waiting in the weapon shop. He appreciates punctuality."])
skip_entry_id = &"ambient"
conditions = Array[ExtResource("5_condition")]([SubResource("ConditionQuest12"), SubResource("ConditionActive")])
responses = Array[ExtResource("3_response")]([SubResource("ResponseShop")])

[sub_resource type="Resource" id="EntryAmbient"]
script = ExtResource("2_entry")
entry_id = &"ambient"
speaker = SubResource("Speaker")
pages = Array[String](["I'm Tamsin Reed, the village alchemist. Careful around the cauldron—restoratives are less restorative before they cool."])
responses = Array[ExtResource("3_response")]([SubResource("ResponseShop")])

[sub_resource type="Resource" id="EntryQuest11Rewarded"]
script = ExtResource("2_entry")
entry_id = &"quest_11_rewarded"
speaker = SubResource("Speaker")
pages = Array[String](["Use it when your health runs low. I may have another favor if you're interested."])
next_entry_id = &"quest_12_offered"

[sub_resource type="Resource" id="EntryQuest12Accepted"]
script = ExtResource("2_entry")
entry_id = &"quest_12_accepted"
speaker = SubResource("Speaker")
pages = Array[String](["Good. You'll find him behind the counter in the weapon shop."])

[sub_resource type="Resource" id="EntryQuest12Declined"]
script = ExtResource("2_entry")
entry_id = &"quest_12_declined"
speaker = SubResource("Speaker")
pages = Array[String](["Very well. The offer will remain open."])

[resource]
script = ExtResource("1_conversation")
conversation_id = &"alchemist_quest_chain"
start_entry_id = &"quest_11_ready"
entries = Array[ExtResource("2_entry")]([SubResource("EntryQuest11Ready"), SubResource("EntryQuest11Active"), SubResource("EntryQuest12Offered"), SubResource("EntryQuest12Active"), SubResource("EntryAmbient"), SubResource("EntryQuest11Rewarded"), SubResource("EntryQuest12Accepted"), SubResource("EntryQuest12Declined")])
