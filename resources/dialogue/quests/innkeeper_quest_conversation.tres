[gd_resource type="Resource" script_class="DialogueConversation" format=3 uid="uid://blib07g4eu50f"]

[ext_resource type="Script" uid="uid://c72ou4xympa8k" path="res://scripts/data/dialogue/dialogue_conversation.gd" id="1_conversation"]
[ext_resource type="Script" uid="uid://de2gtyvn62a4q" path="res://scripts/data/dialogue/dialogue_entry.gd" id="2_entry"]
[ext_resource type="Script" uid="uid://bw8gfgi66jkgt" path="res://scripts/data/dialogue/dialogue_response.gd" id="3_response"]
[ext_resource type="Script" uid="uid://dpbifjko4digr" path="res://scripts/data/dialogue/dialogue_speaker.gd" id="4_speaker"]
[ext_resource type="Script" uid="uid://chsetq55irrf0" path="res://scripts/data/dialogue/dialogue_condition.gd" id="5_condition"]
[ext_resource type="Script" uid="uid://bn5tdgpsujh6q" path="res://scripts/data/dialogue/dialogue_action.gd" id="6_action"]

[sub_resource type="Resource" id="ConditionQuest13"]
script = ExtResource("5_condition")
condition_id = &"context_equals"
parameters = Dictionary[StringName, Variant]({
&"key": &"quest_id",
&"value": 1030
})

[sub_resource type="Resource" id="ConditionReady"]
script = ExtResource("5_condition")
condition_id = &"context_equals"
parameters = Dictionary[StringName, Variant]({
&"key": &"quest_state",
&"value": &"ready"
})

[sub_resource type="Resource" id="ActionTurnIn"]
script = ExtResource("6_action")
action_id = &"turn_in_quest"

[sub_resource type="Resource" id="ResponseTurnIn"]
script = ExtResource("3_response")
text = "Thank you."
next_entry_id = &"quest_13_rewarded"
actions = Array[ExtResource("6_action")]([SubResource("ActionTurnIn")])

[sub_resource type="Resource" id="ActionService"]
script = ExtResource("6_action")
action_id = &"open_service"

[sub_resource type="Resource" id="ResponseRest"]
script = ExtResource("3_response")
text = "I'd like to rest."
actions = Array[ExtResource("6_action")]([SubResource("ActionService")])

[sub_resource type="Resource" id="Speaker"]
script = ExtResource("4_speaker")
speaker_id = &"innkeeper"
display_name = "Elara Vale"

[sub_resource type="Resource" id="EntryReady"]
script = ExtResource("2_entry")
entry_id = &"quest_13_ready"
speaker = SubResource("Speaker")
pages = Array[String](["That's the missing room key! You have no idea how many locks I nearly replaced.", "Please accept some gold for returning it."])
skip_entry_id = &"active_with_key"
conditions = Array[ExtResource("5_condition")]([SubResource("ConditionQuest13"), SubResource("ConditionReady")])
responses = Array[ExtResource("3_response")]([SubResource("ResponseTurnIn"), SubResource("ResponseRest")])

[sub_resource type="Resource" id="ConditionActive"]
script = ExtResource("5_condition")
condition_id = &"context_equals"
parameters = Dictionary[StringName, Variant]({
&"key": &"quest_state",
&"value": &"active"
})

[sub_resource type="Resource" id="ConditionHasKey"]
script = ExtResource("5_condition")
condition_id = &"context_equals"
parameters = Dictionary[StringName, Variant]({
&"key": &"has_delivery_items",
&"value": true
})

[sub_resource type="Resource" id="ActionDeliver"]
script = ExtResource("6_action")
action_id = &"deliver_quest_items"

[sub_resource type="Resource" id="ResponseDeliver"]
script = ExtResource("3_response")
text = "The blacksmith asked me to return this key."
next_entry_id = &"key_delivered"
actions = Array[ExtResource("6_action")]([SubResource("ActionDeliver")])

[sub_resource type="Resource" id="EntryActiveWithKey"]
script = ExtResource("2_entry")
entry_id = &"active_with_key"
speaker = SubResource("Speaker")
pages = Array[String](["Is that our brass room key? I thought it was lost for good."])
skip_entry_id = &"active_without_key"
conditions = Array[ExtResource("5_condition")]([SubResource("ConditionQuest13"), SubResource("ConditionActive"), SubResource("ConditionHasKey")])
responses = Array[ExtResource("3_response")]([SubResource("ResponseDeliver"), SubResource("ResponseRest")])

[sub_resource type="Resource" id="ConditionMissingKey"]
script = ExtResource("5_condition")
condition_id = &"context_equals"
parameters = Dictionary[StringName, Variant]({
&"key": &"has_delivery_items",
&"value": false
})

[sub_resource type="Resource" id="EntryActiveWithoutKey"]
script = ExtResource("2_entry")
entry_id = &"active_without_key"
speaker = SubResource("Speaker")
pages = Array[String](["The blacksmith said he found one of our room keys. Bring it to me if you recover it."])
skip_entry_id = &"completed"
conditions = Array[ExtResource("5_condition")]([SubResource("ConditionQuest13"), SubResource("ConditionActive"), SubResource("ConditionMissingKey")])
responses = Array[ExtResource("3_response")]([SubResource("ResponseRest")])

[sub_resource type="Resource" id="ConditionCompleted"]
script = ExtResource("5_condition")
condition_id = &"context_equals"
parameters = Dictionary[StringName, Variant]({
&"key": &"quest_state",
&"value": &"completed"
})

[sub_resource type="Resource" id="EntryCompleted"]
script = ExtResource("2_entry")
entry_id = &"completed"
speaker = SubResource("Speaker")
pages = Array[String](["Thanks again for returning that key. The room is back in service."])
skip_entry_id = &"ambient"
conditions = Array[ExtResource("5_condition")]([SubResource("ConditionQuest13"), SubResource("ConditionCompleted")])
responses = Array[ExtResource("3_response")]([SubResource("ResponseRest")])

[sub_resource type="Resource" id="EntryAmbient"]
script = ExtResource("2_entry")
entry_id = &"ambient"
speaker = SubResource("Speaker")
pages = Array[String](["Welcome to the inn. I'm Elara Vale, and a warm bed is the best defense against a hard road."])
responses = Array[ExtResource("3_response")]([SubResource("ResponseRest")])

[sub_resource type="Resource" id="EntryKeyDelivered"]
script = ExtResource("2_entry")
entry_id = &"key_delivered"
speaker = SubResource("Speaker")
pages = Array[String](["It is ours! Let me count out a proper reward."])
next_entry_id = &"quest_13_ready"

[sub_resource type="Resource" id="EntryQuest13Rewarded"]
script = ExtResource("2_entry")
entry_id = &"quest_13_rewarded"
speaker = SubResource("Speaker")
pages = Array[String](["You've done the village a real service. Spend the gold wisely."])

[resource]
script = ExtResource("1_conversation")
conversation_id = &"innkeeper_quest_chain"
start_entry_id = &"quest_13_ready"
entries = Array[ExtResource("2_entry")]([SubResource("EntryReady"), SubResource("EntryActiveWithKey"), SubResource("EntryActiveWithoutKey"), SubResource("EntryCompleted"), SubResource("EntryAmbient"), SubResource("EntryKeyDelivered"), SubResource("EntryQuest13Rewarded")])
