[sub_resource type="Resource" id="EntryQuest13Offered"]
script = ExtResource("2_entry")
entry_id = &"quest_1030_offered"
speaker = SubResource("Speaker")
pages = Array[String](["That brass key belongs to the inn. I kept it safe, but I can't leave the forge unattended.", "Will you deliver it to the innkeeper?"])
skip_entry_id = &"quest_1030_active"
conditions = Array[ExtResource("5_condition")]([SubResource("ConditionQuest13"), SubResource("ConditionOffered")])
responses = Array[ExtResource("3_response")]([SubResource("ResponseAccept"), SubResource("ResponseDecline"), SubResource("ResponseShop")])

[sub_resource type="Resource" id="EntryQuest13Active"]
script = ExtResource("2_entry")
entry_id = &"quest_1030_active"
speaker = SubResource("Speaker")
pages = Array[String](["The innkeeper is waiting for that brass key. You'll find the inn just outside."])
skip_entry_id = &"ambient"
conditions = Array[ExtResource("5_condition")]([SubResource("ConditionQuest13"), SubResource("ConditionActive")])
responses = Array[ExtResource("3_response")]([SubResource("ResponseShop")])

[sub_resource type="Resource" id="EntryAmbient"]
script = ExtResource("2_entry")
entry_id = &"ambient"
speaker = SubResource("Speaker")
pages = Array[String](["Garrick Stone, village blacksmith. Steel is honest work—heat it, strike it, and don't rush the temper."])
responses = Array[ExtResource("3_response")]([SubResource("ResponseShop")])

[sub_resource type="Resource" id="EntryQuest12Rewarded"]
