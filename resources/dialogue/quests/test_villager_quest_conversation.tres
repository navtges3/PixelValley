[gd_resource type="Resource" script_class="DialogueConversation" format=3 uid="uid://cswbs4j8jp5wj"]

[ext_resource type="Script" uid="uid://c72ou4xympa8k" path="res://scripts/data/dialogue/dialogue_conversation.gd" id="1_conversation"]
[ext_resource type="Script" uid="uid://de2gtyvn62a4q" path="res://scripts/data/dialogue/dialogue_entry.gd" id="2_entry"]
[ext_resource type="Script" uid="uid://bw8gfgi66jkgt" path="res://scripts/data/dialogue/dialogue_response.gd" id="3_response"]
[ext_resource type="Script" uid="uid://dpbifjko4digr" path="res://scripts/data/dialogue/dialogue_speaker.gd" id="4_speaker"]
[ext_resource type="Script" uid="uid://chsetq55irrf0" path="res://scripts/data/dialogue/dialogue_condition.gd" id="5_condition"]
[ext_resource type="Script" uid="uid://bn5tdgpsujh6q" path="res://scripts/data/dialogue/dialogue_action.gd" id="6_action"]

[sub_resource type="Resource" id="ConditionOffered"]
script = ExtResource("5_condition")
condition_id = &"context_equals"
parameters = Dictionary[StringName, Variant]({
&"key": &"quest_state",
&"value": &"offered"
})

[sub_resource type="Resource" id="ActionAccept"]
script = ExtResource("6_action")
action_id = &"accept_quest"

[sub_resource type="Resource" id="ResponseAccept"]
script = ExtResource("3_response")
text = "I'll speak with the alchemist."
next_entry_id = &"accepted"
actions = Array[ExtResource("6_action")]([SubResource("ActionAccept")])

[sub_resource type="Resource" id="ActionDecline"]
script = ExtResource("6_action")
action_id = &"decline_quest"

[sub_resource type="Resource" id="ResponseDecline"]
script = ExtResource("3_response")
text = "Maybe later."
next_entry_id = &"declined"
actions = Array[ExtResource("6_action")]([SubResource("ActionDecline")])

[sub_resource type="Resource" id="Speaker"]
script = ExtResource("4_speaker")
speaker_id = &"test_villager"
display_name = "Mara"

[sub_resource type="Resource" id="EntryOffered"]
script = ExtResource("2_entry")
entry_id = &"offered"
speaker = SubResource("Speaker")
pages = Array[String](["You look capable. Our alchemist has been testing a new restorative, but she needs someone willing to help.", "Would you go speak with her in the potion shop?"])
skip_entry_id = &"active"
conditions = Array[ExtResource("5_condition")]([SubResource("ConditionOffered")])
responses = Array[ExtResource("3_response")]([SubResource("ResponseAccept"), SubResource("ResponseDecline")])

[sub_resource type="Resource" id="ConditionActive"]
script = ExtResource("5_condition")
condition_id = &"context_equals"
parameters = Dictionary[StringName, Variant]({
&"key": &"quest_state",
&"value": &"active"
})

[sub_resource type="Resource" id="EntryActive"]
script = ExtResource("2_entry")
entry_id = &"active"
speaker = SubResource("Speaker")
pages = Array[String](["The alchemist works in the potion shop. Tell her Mara sent you."])
skip_entry_id = &"completed"
conditions = Array[ExtResource("5_condition")]([SubResource("ConditionActive")])

[sub_resource type="Resource" id="ConditionCompleted"]
script = ExtResource("5_condition")
condition_id = &"context_equals"
parameters = Dictionary[StringName, Variant]({
&"key": &"quest_state",
&"value": &"completed"
})

[sub_resource type="Resource" id="EntryCompleted"]
script = ExtResource("2_entry")
entry_id = &"completed"
speaker = SubResource("Speaker")
pages = Array[String](["I knew the alchemist would have something useful for you."])
skip_entry_id = &"ambient"
conditions = Array[ExtResource("5_condition")]([SubResource("ConditionCompleted")])

[sub_resource type="Resource" id="EntryAmbient"]
script = ExtResource("2_entry")
entry_id = &"ambient"
speaker = SubResource("Speaker")
pages = Array[String](["Welcome to Pixel Valley. Keep an eye on the roads beyond the village."])

[sub_resource type="Resource" id="EntryAccepted"]
script = ExtResource("2_entry")
entry_id = &"accepted"
speaker = SubResource("Speaker")
pages = Array[String](["Thank you. You'll find her behind the counter in the potion shop."])

[sub_resource type="Resource" id="EntryDeclined"]
script = ExtResource("2_entry")
entry_id = &"declined"
speaker = SubResource("Speaker")
pages = Array[String](["No trouble. Ask me again when you're ready."])

[resource]
script = ExtResource("1_conversation")
conversation_id = &"test_villager_quest_chain"
start_entry_id = &"offered"
entries = Array[ExtResource("2_entry")]([SubResource("EntryOffered"), SubResource("EntryActive"), SubResource("EntryCompleted"), SubResource("EntryAmbient"), SubResource("EntryAccepted"), SubResource("EntryDeclined")])
