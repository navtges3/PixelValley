[sub_resource type="Resource" id="ConditionQuest13"]
script = ExtResource("3_he0xk")
condition_id = &"context_equals"
parameters = Dictionary[StringName, Variant]({
&"key": &"quest_id",
&"value": 1030
})

[sub_resource type="Resource" id="ConditionOffered"]
script = ExtResource("3_he0xk")
condition_id = &"context_equals"
parameters = Dictionary[StringName, Variant]({
&"key": &"quest_state",
&"value": &"offered"
})

[sub_resource type="Resource" id="ActionAccept"]
script = ExtResource("2_eeadj")
action_id = &"accept_quest"

[sub_resource type="Resource" id="ResponseAccept"]
script = ExtResource("4_46qlh")
text = "I'll deliver the key."
next_entry_id = &"accepted"
actions = Array[ExtResource("2_eeadj")]([SubResource("ActionAccept")])

[sub_resource type="Resource" id="ActionDecline"]
script = ExtResource("2_eeadj")
action_id = &"decline_quest"

[sub_resource type="Resource" id="ResponseDecline"]
script = ExtResource("4_46qlh")
text = "I can't make the delivery yet."
next_entry_id = &"declined"
actions = Array[ExtResource("2_eeadj")]([SubResource("ActionDecline")])

[sub_resource type="Resource" id="ActionService"]
script = ExtResource("2_eeadj")
action_id = &"open_service"

[sub_resource type="Resource" id="ResponseShop"]
script = ExtResource("4_46qlh")
text = "Show me your weapons."
actions = Array[ExtResource("2_eeadj")]([SubResource("ActionService")])

[sub_resource type="Resource" id="Speaker"]
script = ExtResource("5_86ghv")
speaker_id = &"blacksmith"
display_name = "Garrick Stone"

[sub_resource type="Resource" id="Resource_n432x"]
script = ExtResource("1_qynmc")
entry_id = &"offered"
speaker = SubResource("Speaker")
pages = Array[String](["That brass key belongs to the inn. I kept it safe, but I can't leave the forge unattended.", "Will you deliver it to the innkeeper?"])
conditions = Array[ExtResource("3_he0xk")]([SubResource("ConditionQuest13"), SubResource("ConditionOffered")])
responses = Array[ExtResource("4_46qlh")]([SubResource("ResponseAccept"), SubResource("ResponseDecline"), SubResource("ResponseShop")])

[sub_resource type="Resource" id="ConditionActive"]
script = ExtResource("3_he0xk")
condition_id = &"context_equals"
parameters = Dictionary[StringName, Variant]({
&"key": &"quest_state",
&"value": &"active"
})

[sub_resource type="Resource" id="Resource_eeadj"]
script = ExtResource("1_qynmc")
entry_id = &"active"
speaker = SubResource("Speaker")
pages = Array[String](["The innkeeper is waiting for that brass key. You'll find the inn just outside."])
conditions = Array[ExtResource("3_he0xk")]([SubResource("ConditionQuest13"), SubResource("ConditionActive")])
responses = Array[ExtResource("4_46qlh")]([SubResource("ResponseShop")])

[sub_resource type="Resource" id="Resource_he0xk"]
script = ExtResource("1_qynmc")
entry_id = &"accepted"
speaker = SubResource("Speaker")
pages = Array[String](["Good. Hand the brass key directly to the innkeeper."])

[sub_resource type="Resource" id="Resource_46qlh"]
script = ExtResource("1_qynmc")
entry_id = &"declined"
speaker = SubResource("Speaker")
pages = Array[String](["It can wait here until you're ready."])

[resource]
script = ExtResource("2_script")
sequence_id = &"blacksmith_quest_1030"
quest_id = 1030
start_entry_id = &"offered"
entries = Array[ExtResource("1_qynmc")]([SubResource("Resource_n432x"), SubResource("Resource_eeadj"), SubResource("Resource_he0xk"), SubResource("Resource_46qlh")])
state_entries = Dictionary[StringName, StringName]({
&"active": &"active",
&"offered": &"offered"
})
