[sub_resource type="Resource" id="ConditionVictory"]
script = ExtResource("3_05xf6")
condition_id = &"context_equals"
parameters = Dictionary[StringName, Variant]({
&"key": &"main_progression",
&"value": &"victory"
})

[sub_resource type="Resource" id="Speaker"]
script = ExtResource("5_qd62f")
speaker_id = &"oren"
display_name = "Oren"

[sub_resource type="Resource" id="Resource_joxrg"]
script = ExtResource("1_ap6jc")
entry_id = &"victory"
speaker = SubResource("Speaker")
pages = Array[String](["I've watched this valley weather many hard years, but today feels like the beginning of a better one."])
conditions = Array[ExtResource("3_05xf6")]([SubResource("ConditionVictory")])

[sub_resource type="Resource" id="ConditionOgre"]
script = ExtResource("3_05xf6")
condition_id = &"context_equals"
parameters = Dictionary[StringName, Variant]({
&"key": &"main_progression",
&"value": &"ogre_threat"
})

[sub_resource type="Resource" id="Resource_mkv5m"]
script = ExtResource("1_ap6jc")
entry_id = &"ogre_threat"
speaker = SubResource("Speaker")
pages = Array[String](["Those broken trees are ogre work. I saw the same signs years ago, and I hoped never to see them again."])
conditions = Array[ExtResource("3_05xf6")]([SubResource("ConditionOgre")])

[sub_resource type="Resource" id="ConditionOrc"]
script = ExtResource("3_05xf6")
condition_id = &"context_equals"
parameters = Dictionary[StringName, Variant]({
&"key": &"main_progression",
&"value": &"orc_threat"
})

[sub_resource type="Resource" id="Resource_fsd26"]
script = ExtResource("1_ap6jc")
entry_id = &"orc_threat"
speaker = SubResource("Speaker")
pages = Array[String](["I scouted orc camps when I was younger. Break their command, and the rest usually lose their nerve."])
conditions = Array[ExtResource("3_05xf6")]([SubResource("ConditionOrc")])

[sub_resource type="Resource" id="Resource_00blx"]
script = ExtResource("1_ap6jc")
entry_id = &"goblin_threat"
speaker = SubResource("Speaker")
pages = Array[String](["Name's Oren. I used to scout these woods. Goblins are bold in numbers, but they'll scatter when pressed."])

[resource]
script = ExtResource("6_ic8u5")
sequence_id = &"oren_default"
start_entry_id = &"victory"
entries = Array[ExtResource("1_ap6jc")]([SubResource("Resource_joxrg"), SubResource("Resource_mkv5m"), SubResource("Resource_fsd26"), SubResource("Resource_00blx")])
state_entries = Dictionary[StringName, StringName]({
&"goblin_threat": &"goblin_threat",
&"ogre_threat": &"ogre_threat",
&"orc_threat": &"orc_threat",
&"victory": &"victory"
})
