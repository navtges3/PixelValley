&"key": &"main_progression",
&"value": &"orc_threat"
})

[sub_resource type="Resource" id="Resource_8k1ud"]
script = ExtResource("1_4oper")
entry_id = &"orc_threat"
speaker = SubResource("Speaker")
pages = Array[String](["Orc raids have stopped the supply wagons. We're stretching every sack of grain until the road is safe."])
conditions = Array[ExtResource("3_2f6sx")]([SubResource("ConditionOrc")])

[sub_resource type="Resource" id="Resource_2r0yt"]
script = ExtResource("1_4oper")
entry_id = &"goblin_threat"
speaker = SubResource("Speaker")
pages = Array[String](["I'm Nessa. I tend the fields and keep half the village fed. Goblins stealing from the road make both jobs harder."])

[resource]
script = ExtResource("6_18a6i")
