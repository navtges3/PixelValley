[gd_resource type="Resource" script_class="Quest" load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/data/quests/quest.gd" id="1_quest"]
[ext_resource type="Script" path="res://scripts/data/quests/objectives/delivery_quest_objective.gd" id="2_objective"]
[ext_resource type="Script" path="res://scripts/data/reward.gd" id="3_reward"]

[sub_resource type="Resource" id="DeliveryObjective"]
script = ExtResource("2_objective")
target_npc_id = &"innkeeper"
item_id = "inn_key"
target_amount = 1

[sub_resource type="Resource" id="Reward"]
script = ExtResource("3_reward")
gold = 100

[resource]
script = ExtResource("1_quest")
title = "The Missing Room Key"
id = 13
description = "Deliver the brass room key from the blacksmith to the village innkeeper."
category = 1
source_type = 2
source_id = "blacksmith"
turn_in_npc_id = "innkeeper"
objectives = Array[QuestObjective]([SubResource("DeliveryObjective")])
reward = SubResource("Reward")
